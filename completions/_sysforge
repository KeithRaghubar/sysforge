_sysforge_doctor() {
  local context state state_descr line
  typeset -A opt_args

  _sysforge_help_inline=1
  _arguments -C \
    $_sysforge_help_spec \
    '1: :_sysforge_doctor_subcommands' \
    '*:: :->args'

  case $state in
    args)
      case $words[1] in
        system) _sysforge_doctor_system ;;
        pkg) _sysforge_doctor_pkg ;;
      esac
      ;;
  esac
}

_sysforge_doctor_subcommands() {
  local subcommands=(
    'system:system-state axes (bare `doctor` runs these)'
    'pkg:package-scoped axes over one or more targets'
  )
  _describe 'subcommand' subcommands
}

_sysforge_doctor_system() {
  _sysforge_help_inline=1
  _arguments \
    $_sysforge_help_spec \
    '--graphics[nvidia-drm modeset, driver skew, explicit-sync, session type]' \
    '--gfxperf[advisory graphics-performance sweep]' \
    '--hardware[inventory PCI/USB devices; audit kernel drivers]' \
    '--distro[running distribution and its support tier]' \
    '--toolchain[configured vs installed LLVM; broken libLLVM users]' \
    '--rust[Rust toolchain owner + rustup default; opt-in]' \
    '--cache[compile-cache readiness: ccache/sccache]' \
    '--pacman[pacman-db consistency, .pacnew drift, orphans]' \
    '--config[retired or unknown settings in the live config]' \
    '--state[state integrity: failures, sentinel, drift]' \
    '--boot[boot readiness: kernel artifacts, space, DKMS]' \
    '--restart[processes running superseded code after upgrade]' \
    '--storage[build-dir free space + /etc/fstab integrity]' \
    '--services[failed units, missing firmware, boot errors]' \
    '--audio[failed audio services + vanished output sink]' \
    '--network[default route, manager and DNS conflicts]' \
    '--integrity[verify package files via pacman -Qkk (opt-in)]' \
    '--findings-only[suppress clean lines; print only findings]' \
    '--json[print one JSON document on stdout instead of the report]'
}

_sysforge_doctor_pkg() {
  _sysforge_help_inline=1
  _arguments \
    $_sysforge_help_spec \
    '--abi[unsatisfied depends + soname/ABI linkage of the targets]' \
    '--rust[per-target rust-toolchain.toml pin + install]' \
    '--integrity[verify target files vs alpm mtree (pacman -Qkk)]' \
    '--all[target every installed package (no opt-in axes)]' \
    '--repo[target every native repo package (no opt-in axes)]' \
    '--graphics[target the installed graphics stack; a peer of --all / --repo]' \
    '--shallow[do not recurse into transitive dependencies]' \
    '--findings-only[suppress clean lines; print only packages with issues]' \
    '(-s --suggest)'{-s,--suggest}'[look up packages for each missing soname]' \
    '--apply[hand REBUILD candidates to sysforge update; implies --suggest]' \
    '--yes[skip the y/N prompt before --apply rebuilds]' \
    '--dry-run[report --apply work without rebuilding]' \
    '(--apply)--json[print one JSON document on stdout instead of the report]' \
    '*:installed package:_sysforge_installed_pkg_names'
}

_sysforge_artifact() {
  local context state state_descr line
  typeset -A opt_args

  _arguments -C \
    '1: :_sysforge_artifact_subcommands' \
    '*:: :->args'

  case $state in
    args)
      case $words[1] in
        list) _sysforge_artifact_list ;;
        review) _sysforge_artifact_review ;;
        adopt) _sysforge_artifact_adopt ;;
        edit) _sysforge_artifact_edit ;;
        deploy) _sysforge_artifact_deploy ;;
        remove) _sysforge_artifact_remove ;;
      esac
      ;;
  esac
}

_sysforge_artifact_subcommands() {
  local subcommands=(
    'list:list managed artifacts'
    'review:interactively offer discovered candidates for adoption'
    'adopt:bring a live artifact under management'
    'edit:edit the managed copy of an artifact'
    'deploy:push managed content to the live system'
    'remove:remove an artifact from the live system'
  )
  _describe 'subcommand' subcommands
}

_sysforge_artifact_list() {
  _arguments \
    '--unmanaged[also show discovered candidates not yet adopted]'
}

_sysforge_artifact_review() {
  _arguments \
    '--all[adopt every offerable candidate without prompting]' \
    '--include-unknown[with --all, also adopt candidates of unknown ownership]'
}

_sysforge_artifact_adopt() {
  _arguments \
    '--class[artifact class (inferred from the scan root if omitted)]:class:(script systemd-unit pacman-hook)' \
    '1:path:_files'
}

_sysforge_artifact_edit() {
  _arguments \
    '1:name:'
}

_sysforge_artifact_deploy() {
  _arguments \
    '--all[deploy every managed artifact]' \
    '--force[managed copy wins, discarding the live edit]' \
    '--adopt-live[live file wins, updating the managed copy]' \
    '1:name:'
}

_sysforge_artifact_remove() {
  _arguments \
    '--purge[also delete the managed copy and registry entry]' \
    '--force[remove even though the live file changed outside sysforge]' \
    '1:name:'
}

_sysforge_installed_pkg_names() {
  local -a pkgs
  pkgs=("${(@f)$(pacman -Qq 2>/dev/null)}")
  _describe 'installed package' pkgs
}

_sysforge_packages() {
  local context state state_descr line
  typeset -A opt_args

  _arguments -C \
    '1: :_sysforge_packages_subcommands' \
    '*:: :->args'

  case $state in
    args)
      case $words[1] in
        list)      _sysforge_packages_list      ;;
        add)       _sysforge_packages_add       ;;
        add-group) _sysforge_packages_add_group ;;
        remove)    _sysforge_packages_remove    ;;
      esac
      ;;
  esac
}

_sysforge_packages_subcommands() {
  local subcommands=(
    'list:show override entries in packages.toml'
    'add:add or update an override entry'
    'add-group:write a curated desktop-environment package group'
    'remove:remove an override entry'
  )
  _describe 'subcommand' subcommands
}

_sysforge_packages_list() {
  _arguments \
    '--packages[path to packages.toml]:file:_files' \
    '--orphans[show only entries whose package is not currently installed]'
}

_sysforge_packages_add() {
  _arguments \
    '--packages[path to packages.toml]:file:_files' \
    '--source[pin routing (metadata only)]:source:(repo aur local)' \
    '--enable-build-from-source[build from source]' \
    '--no-cache[disable ccache/sccache (required for PGO)]' \
    '--reason[free-form note attached to the entry]:text' \
    '1: :_sysforge_pkg_names'
}

_sysforge_packages_add_group() {
  _arguments \
    '--packages[path to packages.toml]:file:_files' \
    '1:desktop:(gnome kde xfce mate cinnamon lxqt budgie cosmic)'
}

_sysforge_packages_remove() {
  _arguments \
    '--packages[path to packages.toml]:file:_files' \
    '1: :_sysforge_manifest_names'
}

_sysforge_state() {
  local context state state_descr line
  typeset -A opt_args

  _arguments -C \
    '1: :_sysforge_state_subcommands' \
    '*:: :->args'

  case $state in
    args)
      case $words[1] in
        list)    _sysforge_state_list    ;;
        repair)  _sysforge_state_repair  ;;
        orphans) _sysforge_state_orphans ;;
        profiles) _sysforge_state_profiles ;;
        boot-entries) _sysforge_state_boot_entries ;;
        failed)  _sysforge_state_failed  ;;
        forget)  _sysforge_state_forget  ;;
      esac
      ;;
  esac
}

_sysforge_state_subcommands() {
  local subcommands=(
    'list:tabulate build_state.toml entries'
    'repair:re-parse PKGBUILDs to fix entries with unexpanded variables'
    'orphans:list (and optionally delete) stale artifacts in PKGDEST'
    'profiles:list collected optimization profiles (and optionally delete one)'
    'boot-entries:show which loader entry boots each kernel'
    'failed:list recorded build failures (with any diagnosed fix)'
    'forget:stop maintaining package(s) (delete their build_state record)'
  )
  _describe 'subcommand' subcommands
}

