#compdef sysforge

_sysforge() {
  local context state state_descr line
  typeset -A opt_args

  _arguments -C \
    '(-v --verbose)'{-v,--verbose}'[increase verbosity (repeat for more: -vv, -vvv)]' \
    '1: :_sysforge_commands' \
    '*:: :->args'

  case $state in
    args)
      case $words[1] in
        build)    _sysforge_build    ;;
        fetch)    _sysforge_fetch    ;;
        update)   _sysforge_update   ;;
        resolve)  _sysforge_resolve  ;;
        converge) _sysforge_converge ;;
        packages) _sysforge_packages ;;
        run)      _sysforge_run      ;;
        setup)    _sysforge_setup    ;;
      esac
      ;;
  esac
}

_sysforge_commands() {
  local commands=(
    'build:build a package from a PKGBUILD'
    'fetch:download PKGBUILD(s) into pkgbuild_dir without building'
    'update:check for and rebuild outdated sysforge-managed packages'
    'resolve:show which profile would apply to a package'
    'converge:rebuild packages that have drifted from their profile'
    'packages:manage packages.toml (list, add, remove, sync)'
    'run:execute a pipeline stage'
    'setup:configure system integration (pacman IgnoreGroup for sf-build)'
  )
  _describe 'command' commands
}

_sysforge_pkg_names() {
  local limit=200
  local -a pkgs
  if [[ -z ${PREFIX} ]]; then
    pkgs=("${(@f)$(sysforge completions local 2>/dev/null)}")
    _describe 'package' pkgs
    return
  fi
  pkgs=("${(@f)$(sysforge completions packages 2>/dev/null | grep -m $((limit + 1)) -- "^${PREFIX}")}")
  if (( $#pkgs > limit )); then
    zle -M "${limit}+ candidates — type more characters to narrow"
    _sysforge_clear_msg() {
      zle -M ""
      add-zle-hook-widget -d zle-line-pre-redraw _sysforge_clear_msg
    }
    autoload -Uz add-zle-hook-widget
    add-zle-hook-widget zle-line-pre-redraw _sysforge_clear_msg
    return
  fi
  _describe 'package' pkgs
}

_sysforge_manifest_names() {
  local -a pkgs
  pkgs=("${(@f)$(sysforge completions manifest 2>/dev/null)}")
  _describe 'package' pkgs
}

_sysforge_local_pkg_names() {
  local -a pkgs
  pkgs=("${(@f)$(sysforge completions local 2>/dev/null)}")
  _describe 'package' pkgs
}

_sysforge_state_names() {
  local -a pkgs
  pkgs=("${(@f)$(sysforge completions state 2>/dev/null)}")
  _describe 'package' pkgs
}

_sysforge_pkg_or_file() {
  _alternative \
    'files:file:_files' \
    'packages:package:_sysforge_pkg_names'
}

_sysforge_makepkg_flags() {
  local -a flags
  flags=("${(@f)$(sysforge completions makepkg-flags 2>/dev/null)}")
  (( $#flags )) && _describe -t makepkg-flags 'makepkg flag' flags
}

_sysforge_build() {
  _arguments \
    '(-m --makepkg)'{-m,--makepkg}'[extra makepkg flags, appended after profile flags]:flags' \
    '--interactive[strip --noconfirm from makepkg_flags]' \
    '--profile-conf[alternate flag_profiles.toml]:file:_files' \
    '--cc[override C compiler for this build]:compiler' \
    '--cxx[override C++ compiler for this build]:compiler' \
    '--ld[override linker for this build]:linker:(lld mold ld bfd)' \
    '--no-pkg-log[disable per-package log file]' \
    '--log-dir[directory for per-package log]:directory:_files -/' \
    '--persist-log[keep log after a successful build]' \
    '--cache-report[print ccache/sccache summary after build]' \
    '--abi-check[run post-build ABI compatibility check on built shared libraries]' \
    '--no-update[skip git pull --rebase before building]' \
    '--state-dir[override state directory]:directory:_files -/' \
    '*: :_sysforge_pkg_or_file' \
  && return
  _sysforge_makepkg_flags
}

_sysforge_fetch() {
  _arguments \
    '--no-update[skip git pull --rebase for already-cloned packages]' \
    '--profile-conf[alternate flag_profiles.toml]:file:_files' \
    '*: :_sysforge_pkg_names'
}

_sysforge_update() {
  _arguments \
    '--all[discover foreign packages (pacman -Qm) and add to packages.toml]' \
    '--packages[path to packages.toml for --all discovery]:file:_files' \
    '--dry-run[show what would be rebuilt without doing it]' \
    '--devel[include VCS packages (-git, -svn, -hg, -bzr)]' \
    '--no-update[skip git pull --rebase before checking versions]' \
    '--interactive[pause on build failures to allow manual correction]' \
    '--no-cleanbuild[skip automatic --cleanbuild; useful to re-run only the install step]' \
    '(-m --makepkg)'{-m,--makepkg}'[extra makepkg flags]:flags' \
    '--no-unified-log[disable unified log file]' \
    '--purge-log[truncate unified log before this run]' \
    '--state-dir[override state directory]:directory:_files -/' \
    '--profile-conf[alternate flag_profiles.toml]:file:_files' \
    '--cache-report[print ccache/sccache summary after run]' \
    '--no-pkg-log[disable per-package log files]' \
    '--persist-log[keep log files after successful completion]' \
    '--log-dir[directory for per-package log files]:directory:_files -/' \
    '*: :_sysforge_state_names' \
  && return
  _sysforge_makepkg_flags
}

_sysforge_resolve() {
  _arguments \
    '--show-flags[print the full resolved flag set]' \
    '--profile-conf[alternate flag_profiles.toml]:file:_files' \
    '1: :_sysforge_local_pkg_names'
}


_sysforge_converge() {
  _arguments \
    '--apply[rebuild all packages whose flags have drifted from the current profile]' \
    '--state-dir[override state directory]:directory:_files -/' \
    '--profile-conf[alternate flag_profiles.toml]:file:_files' \
    '--no-pkg-log[disable per-package log files (only relevant with --apply)]' \
    '--persist-log[keep log files after completion (only relevant with --apply)]' \
    '--log-dir[directory for per-package log files]:directory:_files -/' \
    '--cache-report[print ccache/sccache summary after --apply]' \
  && return
  _sysforge_makepkg_flags
}

_sysforge_packages() {
  local context state state_descr line
  typeset -A opt_args

  _arguments -C \
    '--packages[path to packages.toml]:file:_files' \
    '1: :_sysforge_packages_subcommands' \
    '*:: :->args'

  case $state in
    args)
      case $words[1] in
        list)   _sysforge_packages_list   ;;
        add)    _sysforge_packages_add    ;;
        remove) _sysforge_packages_remove ;;
        sync)   _sysforge_packages_sync   ;;
      esac
      ;;
  esac
}

_sysforge_packages_subcommands() {
  local subcommands=(
    'list:show packages in packages.toml'
    'add:add a package entry'
    'remove:remove a package entry'
    'sync:re-validate inferable fields (source, pkgbuild_patch)'
  )
  _describe 'subcommand' subcommands
}

_sysforge_packages_list() {
  _arguments \
    '--packages[path to packages.toml]:file:_files'
}

_sysforge_packages_add() {
  _arguments \
    '--packages[path to packages.toml]:file:_files' \
    '*: :_sysforge_pkg_names'
}

_sysforge_packages_remove() {
  _arguments \
    '--packages[path to packages.toml]:file:_files' \
    '1: :_sysforge_manifest_names'
}

_sysforge_packages_sync() {
  _arguments \
    '--packages[path to packages.toml]:file:_files' \
    '--dry-run[show what would change without writing]'
}

_sysforge_run() {
  local context state state_descr line
  typeset -A opt_args

  _arguments -C \
    '1: :_sysforge_run_stages' \
    '*:: :->args'

  case $state in
    args)
      case $words[1] in
        pipeline)    _sysforge_run_pipeline    ;;
        hardware)    _sysforge_run_hardware    ;;
        reconfigure) _sysforge_run_reconfigure ;;
        toolchain)   _sysforge_run_toolchain   ;;
        packages)    _sysforge_run_packages    ;;
        kernel)      _sysforge_run_kernel      ;;
      esac
      ;;
  esac
}

_sysforge_run_stages() {
  local stages=(
    'pipeline:run the full install pipeline (stages 1-8)'
    'hardware:re-run hardware detection and refresh hardware_profile.toml'
    'reconfigure:pre-build checkpoint'
    'toolchain:build and install the LLVM/GCC toolchain'
    'packages:build and install packages from packages.toml'
    'kernel:build and install the custom kernel'
  )
  _describe 'stage' stages
}

_sysforge_run_hardware() {
  _arguments \
    '--dry-run[show what would be written without writing]' \
    '--state-dir[override state directory]:directory:_files -/'
}

_sysforge_run_pipeline() {
  _arguments \
    '--resume[continue from the last checkpoint]' \
    '--start-from[begin from this stage]:stage:(reconfigure toolchain packages kernel)' \
    '--force-retry[retry failed packages without prompting]' \
    '--dry-run[show what would run without executing]' \
    '--packages[path to packages.toml]:file:_files' \
    '--state-dir[override state directory]:directory:_files -/' \
    '--profile-conf[alternate flag_profiles.toml]:file:_files' \
    '--no-unified-log[disable unified log file]' \
    '--no-pkg-logs[disable per-package log files]' \
    '--log-dir[directory for log files]:directory:_files -/' \
    '--purge-log[truncate unified log before this run]' \
    '--persist-log[keep logs after successful run]' \
    '--cache-report[print ccache/sccache summary after pipeline]' \
    '--abi-check[run post-build ABI compatibility check on built shared libraries]' \
    '--no-update[skip git pull --rebase before each build]'
}

_sysforge_run_reconfigure() {
  _arguments \
    '--dry-run[run all steps non-interactively without writing changes]' \
    '--packages[path to packages.toml]:file:_files' \
    '--state-dir[override state directory]:directory:_files -/'
}

_sysforge_run_toolchain() {
  _arguments \
    '--dry-run[show what would run without executing]' \
    '--no-update[skip git pull --rebase before each build]' \
    '(-m --makepkg)'{-m,--makepkg}'[extra makepkg flags]:flags' \
    '--persist-log[keep logs after successful run]' \
    '--cache-report[print ccache/sccache summary after run]' \
    '--abi-check[run post-build ABI compatibility check on built shared libraries]' \
    '--state-dir[override state directory]:directory:_files -/' \
  && return
  _sysforge_makepkg_flags
}

_sysforge_run_packages() {
  _arguments \
    '--packages[path to packages.toml]:file:_files' \
    '--dry-run[show what would run without executing]' \
    '--force-retry[retry failed packages without prompting]' \
    '--no-update[skip git pull --rebase before each build]' \
    '--no-pkg-logs[disable per-package log files]' \
    '--persist-log[keep logs after successful run]' \
    '--log-dir[directory for log files]:directory:_files -/' \
    '--cache-report[print ccache/sccache summary after run]' \
    '--abi-check[run post-build ABI compatibility check on built shared libraries]' \
    '--state-dir[override state directory]:directory:_files -/' \
    '--profile-conf[alternate flag_profiles.toml]:file:_files'
}

_sysforge_run_kernel() {
  _arguments \
    '--dry-run[show what would run without executing]' \
    '--no-update[skip git pull --rebase before each build]' \
    '--no-pkg-logs[disable per-package log files]' \
    '--persist-log[keep logs after successful run]' \
    '--log-dir[directory for log files]:directory:_files -/' \
    '--cache-report[print ccache/sccache summary after run]' \
    '--abi-check[run post-build ABI compatibility check on built shared libraries]' \
    '--state-dir[override state directory]:directory:_files -/'
}

_sysforge_setup() {
  _arguments \
    '--pacman-conf[path to pacman.conf]:file:_files'
}
