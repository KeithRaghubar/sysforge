#compdef sysforge

_sysforge() {
  local context state state_descr line
  typeset -A opt_args

  _arguments -C \
    '(-V --version)'{-V,--version}'[print sysforge version and exit]' \
    '(-h --help)'{-h,--help}'[show this help message and exit]' \
    '(-v --verbose)'{-v,--verbose}'[increase verbosity (repeat for more: -vv, -vvv)]' \
    '--quiet[suppress all non-error output, overriding -v]' \
    '--py-profile[run the verb under cProfile, print top functions at exit]' \
    '--py-profile-out[write raw cProfile stats to FILE]:file:_files' \
    '--timings[print phase wall-clock timing report after build/update]' \
    '--color[colorize output]:when:(auto always never)' \
    '--no-throttle[ignore the configured build throttle for this run]' \
    '--turbo[raise build priority (stronger than --no-throttle)]' \
    '--frozen[refuse all new source downloads for this run]' \
    '--no-frozen[lift the source freeze for this run]' \
    '*--thaw[exempt pkgbases from the source freeze]:pkgbase:' \
    '1: :_sysforge_commands' \
    '*:: :->args'

  case $state in
    args)
      case $words[1] in
        artifact) _sysforge_artifact ;;
        build)    _sysforge_build    ;;
        fetch)    _sysforge_fetch    ;;
        update)   _sysforge_update   ;;
        resolve)  _sysforge_resolve  ;;
        doctor)   _sysforge_doctor   ;;
        packages) _sysforge_packages ;;
        state)    _sysforge_state    ;;
        revert-to-stock) _sysforge_revert ;;
        run)      _sysforge_run      ;;
        search)   _sysforge_search   ;;
        setup)    _sysforge_setup    ;;
        uninstall) _sysforge_uninstall ;;
        env)      _sysforge_env      ;;
        help)     _sysforge_help     ;;
        log)      _sysforge_log      ;;
        config)   _sysforge_config   ;;
        completions) _sysforge_completions ;;
      esac
      # argparse auto-adds -h/--help to every parser, so the flag is valid at
      # every level. Offered here once (2.5.0-F2) instead of in each verb's
      # `_arguments` spec; `-o` keeps it out of the way of real matches.
      _sysforge_help_flag
      ;;
  esac
}

_sysforge_help_flag() {
  [[ ${PREFIX} == -* ]] || return
  local -a hf=(
    '-h:show this help message and exit'
    '--help:show this help message and exit'
  )
  _describe -o 'option' hf
}

_sysforge_commands() {
  # Ordered by usage tier to mirror `sysforge --help` (2.5.0-F1):
  # Everyday, then Inspect, then Maintain.
  local commands=(
    'build:build a package from a PKGBUILD'
    'update:check for and rebuild outdated sysforge-managed packages'
    'fetch:download PKGBUILD(s) into pkgbuild_src_dir without building'
    'search:search installed, repo, and AUR packages for a term'
    'help:print help for sysforge or for a COMMAND (alias for --help)'
    'doctor:health-check installed package depends + linkage'
    'resolve:show which profile would apply to a package'
    'env:print the inherited env chain'
    'log:page the unified or per-package sysforge log through $PAGER'
    'state:inspect or repair build_state.toml (list, repair, orphans)'
    'artifact:inventory user-authored scripts, units, and pacman hooks'
    'setup:configure system integration (IgnoreGroup, pacman hooks)'
    'config:adopt .sfnew/.pacnew config companions (merge)'
    'packages:manage packages.toml override entries (list, add, remove)'
    'run:execute a pipeline stage'
    'revert-to-stock:restore a source-built package to the repo version'
    'uninstall:remove package(s); demote tracked ones from build state'
  )
  _describe 'command' commands
}

_sysforge_pkg_names() {
  local limit=200
  local -a pkgs
  if [[ -z ${PREFIX} ]]; then
    pkgs=("${(@f)$(sysforge completions local 2>/dev/null)}")
    _describe 'package' pkgs
    return
  fi
  pkgs=("${(@f)$(sysforge completions packages 2>/dev/null | grep -m $((limit + 1)) -- "^${PREFIX}")}")
  if (( $#pkgs > limit )); then
    zle -M "${limit}+ candidates — type more characters to narrow"
    _sysforge_clear_msg() {
      zle -M ""
      add-zle-hook-widget -d zle-line-pre-redraw _sysforge_clear_msg
    }
    autoload -Uz add-zle-hook-widget
    add-zle-hook-widget zle-line-pre-redraw _sysforge_clear_msg
    return
  fi
  _describe 'package' pkgs
}

_sysforge_manifest_names() {
  local -a pkgs
  pkgs=("${(@f)$(sysforge completions manifest 2>/dev/null)}")
  _describe 'package' pkgs
}

_sysforge_local_pkg_names() {
  local -a pkgs
  pkgs=("${(@f)$(sysforge completions local 2>/dev/null)}")
  _describe 'package' pkgs
}

_sysforge_state_names() {
  local -a pkgs
  pkgs=("${(@f)$(sysforge completions state 2>/dev/null)}")
  _describe 'package' pkgs
}

_sysforge_pkg_or_file() {
  _alternative \
    'files:file:_files' \
    'packages:package:_sysforge_pkg_names'
}

_sysforge_makepkg_flags() {
  local -a flags
  flags=("${(@f)$(sysforge completions makepkg-flags 2>/dev/null)}")
  (( $#flags )) && _describe -t makepkg-flags 'makepkg flag' flags
}

_sysforge_build() {
  _arguments \
    '(-m --makepkg)'{-m,--makepkg}'[extra makepkg flags, appended after profile flags]:flags' \
    '--interactive[strip --noconfirm from makepkg_flags]' \
    '--profile-conf[alternate profiles.toml]:file:_files' \
    '--cc[override C compiler for this build]:compiler' \
    '--cxx[override C++ compiler for this build]:compiler' \
    '--ld[override linker for this build]:linker:(lld mold ld bfd)' \
    '--no-pkg-log[disable per-package log file]' \
    '--log-dir[directory for per-package log]:directory:_files -/' \
    '--persist-log[keep log after a successful build]' \
    '--cache-report[print ccache/sccache summary after build]' \
    '--abi-check[post-build ABI check on built shared libraries]' \
    '--no-update[skip git pull --rebase before building]' \
    '--cleansrc[purge src dir and re-clone (refuses if dirty)]' \
    '--cleansrc-force[purge + re-clone, bypassing the dirty guard]' \
    '--no-llvm-preflight[suppress the LLVM source pre-flight summary]' \
    '--no-review[skip the PKGBUILD review gate (source-change diff prompt)]' \
    '--force[build from source this run only; no packages.toml write]' \
    '--rebuild[force makepkg -f even if already built]' \
    '--pgo[instrumentation PGO, LLVM only]:mode:(record use)' \
    '--state-dir[override state directory]:directory:_files -/' \
    '*: :_sysforge_pkg_or_file' \
  && return
  _sysforge_makepkg_flags
}

_sysforge_fetch() {
  _arguments \
    '--no-update[skip git pull --rebase for already-cloned packages]' \
    '--cleansrc[purge src dirs and re-clone (refuses if dirty)]' \
    '--cleansrc-force[purge + re-clone, bypassing the dirty/diverged guard]' \
    '--no-llvm-preflight[suppress the LLVM source pre-flight summary]' \
    '--profile-conf[alternate profiles.toml]:file:_files' \
    '*: :_sysforge_pkg_names'
}

