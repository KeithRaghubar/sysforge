    '--devel[rebuild VCS packages newer than installed]' \
    '--offline[no network: skip pulls, clones, and AUR RPC]' \
    '--install-only[install pre-built PKGDEST artifacts only]' \
    '--interactive[pause on build failures for manual fixes]' \
    '--no-cleanbuild[skip automatic --cleanbuild]' \
    '--cleansrc[purge src dirs and re-clone (rebuilds only)]' \
    '--cleansrc-force[purge + re-clone, bypassing the dirty guard]' \
    '--no-llvm-preflight[suppress the LLVM source pre-flight summary]' \
    '(--no-review)--review[prompt to review source-change diffs]' \
    '(--review)--no-review[skip the PKGBUILD review gate]' \
    '(--no-sysupgrade)--sysupgrade[finish the run with one pacman -Syu]' \
    '(--sysupgrade)--no-sysupgrade[skip the trailing pacman -Syu]' \
    '--no-toolchain-preflight[skip the toolchain pre-flight]' \
    '--include-stage-owned[include stage-owned packages]' \
