_sysforge_doctor() {
  local context state state_descr line
  typeset -A opt_args

  _arguments -C \
    '1: :_sysforge_doctor_subcommands' \
    '(-q --quiet)'{-q,--quiet}'[suppress clean lines; print only findings]' \
    '*:: :->args'

  case $state in
    args)
      case $words[1] in
        system) _sysforge_doctor_system ;;
        pkg) _sysforge_doctor_pkg ;;
      esac
      ;;
  esac
}

_sysforge_doctor_subcommands() {
  local subcommands=(
    'system:system-state axes (bare `doctor` runs these)'
    'pkg:package-scoped axes over one or more targets'
  )
  _describe 'subcommand' subcommands
}

_sysforge_doctor_system() {
  _arguments \
    '--graphics[nvidia-drm modeset, driver skew, explicit-sync, session type]' \
    '--gfxperf[advisory graphics-performance sweep]' \
    '--hardware[inventory PCI/USB devices; audit kernel drivers]' \
    '--distro[running distribution and its support tier]' \
    '--toolchain[configured toolchain vs installed LLVM]' \
    '--rust[Rust toolchain owner + rustup default; opt-in]' \
    '--cache[compile-cache readiness: ccache/sccache]' \
    '--pacman[pacman-db consistency, .pacnew drift, orphans]' \
    '--state[state integrity: failures, sentinel, drift]' \
    '--boot[boot readiness: kernel artifacts, space, DKMS]' \
    '--restart[processes running superseded code after upgrade]' \
    '--storage[storage/filesystem: build-dir free space + /etc/fstab integrity]' \
    '--services[failed units, missing firmware, boot errors]' \
    '--audio[failed audio services + vanished output sink]' \
    '--network[default route, manager and DNS conflicts]' \
    '--integrity[verify package-owned files vs alpm mtree via pacman -Qkk (opt-in)]' \
    '(-q --quiet)'{-q,--quiet}'[suppress clean lines; print only findings]'
}

_sysforge_doctor_pkg() {
  _arguments \
    '--abi[depends-satisfaction + soname/ABI linkage walk over the targets]' \
    '--rust[per-target rust-toolchain.toml pin + install]' \
    '--integrity[verify target files vs alpm mtree (pacman -Qkk)]' \
    '--all[target every installed package (no opt-in axes)]' \
    '--repo[target every native repo package (no opt-in axes)]' \
    '--graphics[target the installed graphics stack; a peer of --all / --repo]' \
    '--shallow[do not recurse into transitive dependencies]' \
    '(-q --quiet)'{-q,--quiet}'[suppress clean lines; print only packages with issues]' \
    '(-s --suggest)'{-s,--suggest}'[look up packages for each missing soname]' \
    '--apply[hand REBUILD candidates to sysforge update; implies --suggest]' \
    '--no-confirm[skip the y/N prompt before --apply rebuilds]' \
    '--dry-run[report --apply work without rebuilding]' \
