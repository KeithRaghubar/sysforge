  typeset -A opt_args

  _arguments -C \
    '1: :_sysforge_state_subcommands' \
    '*:: :->args'

  case $state in
    args)
      case $words[1] in
        list)    _sysforge_state_list    ;;
        repair)  _sysforge_state_repair  ;;
        orphans) _sysforge_state_orphans ;;
        failed)  _sysforge_state_failed  ;;
        forget)  _sysforge_state_forget  ;;
      esac
