    '--rebuild-profdata[force a full 4-pass PGO build]' \
    '--reuse-built[reuse unchanged Pass-3 packages; opt-in]' \
    '--bolt-only[BOLT the last build tree and install; no build]' \
    '--install-only[install the last built toolchain; no build]' \
    '--yes[bypass PGO confirmation prompts]' \
    '--allow-dirty-llvm[bypass the dirty-tree pre-flight refusal]' \
    '--allow-version-skew[override the Gate-1 pkgver-skew abort]' \
    '--allow-low-build-space[override the Gate-1 space check]' \
    '--rebuild-soname-consumers[rebuild libLLVM consumers on a soname bump]:mode:(prompt auto off)' \
    '--cleansrc[purge toolchain src dirs and re-clone]' \
    '--cleansrc-force[purge + re-clone, bypassing the dirty guard]' \
  && return
  _sysforge_makepkg_flags
}

_sysforge_run_packages() {
  _arguments \
    '--packages[path to packages.toml]:file:_files' \
    '--dry-run[show what would run without executing]' \
    '--retry-failed[retry failed packages without prompting]' \
    '--no-update[skip the source sync, build as checked out]' \
    '--no-pkg-log[disable per-package log files]' \
    '--persist-log[keep logs after successful run]' \
    '--log-dir[directory for log files]:directory:_files -/' \
    '--cache-report[print ccache/sccache summary after run]' \
    '--abi-check[post-build ABI check on built shared libraries]' \
    '--state-dir[override state directory]:directory:_files -/' \
    '--profile-conf[alternate profiles.toml]:file:_files'
}

_sysforge_run_kernel() {
  _arguments \
    '--dry-run[show what would run without executing]' \
    '--no-update[skip the source sync, build as checked out]' \
    '--cleansrc[purge the kernel src dir and re-clone]' \
    '--cleansrc-force[--cleansrc, bypassing the dirty guard]' \
    '--no-interactive[use olddefconfig, no interactive kconfig]' \
    '--toolchain[build the kernel with this toolchain]:toolchain:(gcc llvm)' \
    '--bootloader[override kernel.toml bootloader]:bootloader:(systemd-boot grub none)' \
    '--base-config[override kernel.toml base_config]:source:_sysforge_base_config_source' \
    '--base-config-merge[override kernel.toml base_config_merge]:mode:(replace overlay)' \
    '--allow-no-fallback[override the fallback-kernel guarantee (Gate 1)]' \
    '--allow-boot-audit-failure[override the Gate-2 boot audit; dangerous]' \
    '--headers[build the -headers subpackage (default on)]' \
    '--no-headers[drop -headers; DKMS cannot rebuild]' \
    '--docs[build the -docs subpackage]' \
    '--no-docs[drop the -docs subpackage (the default)]' \
    '--keep-hotplug-drivers[re-enable hotplug drivers as modules]' \
    '--no-keep-hotplug-drivers[leave hotplug drivers off (default)]' \
    '--autofdo[sample-based kernel FDO step (LLVM only)]:step:(record capture use)' \
    '--propeller[round 2: Propeller on the pinned AutoFDO profile]' \
    '--no-pkg-log[disable per-package log files]' \
    '--persist-log[keep logs after successful run]' \
    '--log-dir[directory for log files]:directory:_files -/' \
    '--cache-report[print ccache/sccache summary after run]' \
    '--abi-check[post-build ABI check on built shared libraries]' \
    '--state-dir[override state directory]:directory:_files -/' \
    '--profile-conf[alternate profiles.toml]:file:_files'
}

_sysforge_setup() {
  _arguments \
    '--pacman-conf[path to pacman.conf]:file:_files' \
    '--preset[apply a config preset without asking]:preset:(defaults performance low-friction secure)'
}

_sysforge_env() {
  _arguments
}

_sysforge_help() {
  # `sysforge help [COMMAND [SUBCOMMAND]]`: first word is any verb, second is
  # that verb's subcommand when it has one (2.5.0-F2).
  case $CURRENT in
    2) _sysforge_commands ;;
    3)
      case $words[2] in
        artifact) _sysforge_artifact_subcommands ;;
        config)   _sysforge_config_subcommands   ;;
        doctor)   _sysforge_doctor_subcommands   ;;
        packages) _sysforge_packages_subcommands ;;
        run)      _sysforge_run_stages           ;;
        state)    _sysforge_state_subcommands    ;;
        bench)    _sysforge_bench_targets        ;;
      esac
      ;;
  esac
}

# --base-config takes a keyword or a path to a .config file.
_sysforge_base_config_source() {
  _alternative 'keywords:keyword:(pkgbuild running)' 'files:.config file:_files'
}

_sysforge_log() {
  _arguments \
    '(1)--verb[page a verb'"'"'s consolidated log]:verb:(build config-clean config-merge config-reset doctor fetch revert-to-stock run-hardware run-kernel run-packages run-reconfigure run-toolchain setup state-forget state-repair uninstall update)' \
    '--log-dir[directory the log was written to]:directory:_files -/' \
    '--state-dir[override state directory]:directory:_files -/' \
    '--no-pager[do not pipe output through $PAGER]' \
    '(--verb)1: :_sysforge_local_pkg_names'
}

_sysforge_config() {
  local context state state_descr line
  typeset -A opt_args

  _arguments -C \
    '1: :_sysforge_config_subcommands' \
    '*:: :->args'

  case $state in
    args)
      case $words[1] in
        check) _sysforge_config_check ;;
        clean) _sysforge_config_clean ;;
        reset) _sysforge_config_reset ;;
        merge) _sysforge_config_merge ;;
      esac
      ;;
  esac
}

_sysforge_config_subcommands() {
  local subcommands=(
    'check:report retired or unknown settings in the live config'
    'clean:rewrite retired settings (--unknown: drop unknown ones)'
    'reset:put keys, or a whole file, back to the shipped default'
    'merge:interactively adopt or clear .sfnew/.pacnew config companions'
  )
  _describe 'subcommand' subcommands
}

_sysforge_config_check() {
  _arguments \
    '--config-dir[live config dir to check]:directory:_files -/'
}

_sysforge_config_clean() {
  _arguments \
    '--config-dir[live config dir to clean]:directory:_files -/' \
    '--unknown[also remove settings sysforge does not know]' \
    '--dry-run[show the diff without writing]' \
    '--yes[write without asking]'
}

_sysforge_config_reset() {
  _arguments \
    '--config-dir[live config dir]:directory:_files -/' \
    '--dry-run[show the diff without writing]' \
    '--yes[write without asking]' \
    '1:file:(sysforge.toml profiles.toml packages.toml kernel.toml toolchain.toml)' \
    '*:key (SECTION.KEY):'
}

_sysforge_config_merge() {
  _arguments \
    '--config-dir[live config dir to scan]:directory:_files -/' \
    '--dry-run[list companion files without prompting or merging]' \
    '--no-pager[do not pipe diffs through $PAGER]'
}

# Internal scaffolding subcommand used by this completion script itself
# (see _sysforge_pkg_names, _sysforge_makepkg_flags, etc.). Hidden from
# `sysforge --help` (argparse.SUPPRESS) but exposed here so that
# `sysforge completions <TAB>` completes the resource argument.
_sysforge_completions() {
  _arguments \
    '1:resource:(packages manifest local state makepkg-flags)'
}
