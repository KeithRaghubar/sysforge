#compdef sysforge

_sysforge() {
  local context state state_descr line
  typeset -A opt_args

  _arguments -C \
    '(-V --version)'{-V,--version}'[print sysforge version and exit]' \
    '(-v --verbose)'{-v,--verbose}'[increase verbosity (repeat for more: -vv, -vvv)]' \
    '1: :_sysforge_commands' \
    '*:: :->args'

  case $state in
    args)
      case $words[1] in
        build)    _sysforge_build    ;;
        fetch)    _sysforge_fetch    ;;
        update)   _sysforge_update   ;;
        resolve)  _sysforge_resolve  ;;
        converge) _sysforge_converge ;;
        doctor)   _sysforge_doctor   ;;
        packages) _sysforge_packages ;;
        state)    _sysforge_state    ;;
        run)      _sysforge_run      ;;
        setup)    _sysforge_setup    ;;
        env)      _sysforge_env      ;;
        log)      _sysforge_log      ;;
        completions) _sysforge_completions ;;
      esac
      ;;
  esac
}

_sysforge_commands() {
  local commands=(
    'build:build a package from a PKGBUILD'
    'fetch:download PKGBUILD(s) into pkgbuild_src_dir without building'
    'update:check for and rebuild outdated sysforge-managed packages'
    'resolve:show which profile would apply to a package'
    'converge:rebuild packages that have drifted from their profile'
    'doctor:health-check installed package depends + linkage'
    'packages:manage packages.toml override entries (list, add, remove)'
    'state:inspect or repair build_state.toml (list, repair, orphans)'
    'run:execute a pipeline stage'
    'setup:configure system integration (pacman IgnoreGroup for sf-build)'
    'env:print the inherited env chain (shell vars, parent processes, shell init files)'
    'log:page the unified or per-package sysforge log through $PAGER'
  )
  _describe 'command' commands
}

_sysforge_pkg_names() {
  local limit=200
  local -a pkgs
  if [[ -z ${PREFIX} ]]; then
    pkgs=("${(@f)$(sysforge completions local 2>/dev/null)}")
    _describe 'package' pkgs
    return
  fi
  pkgs=("${(@f)$(sysforge completions packages 2>/dev/null | grep -m $((limit + 1)) -- "^${PREFIX}")}")
  if (( $#pkgs > limit )); then
    zle -M "${limit}+ candidates — type more characters to narrow"
    _sysforge_clear_msg() {
      zle -M ""
      add-zle-hook-widget -d zle-line-pre-redraw _sysforge_clear_msg
    }
    autoload -Uz add-zle-hook-widget
    add-zle-hook-widget zle-line-pre-redraw _sysforge_clear_msg
    return
  fi
  _describe 'package' pkgs
}

_sysforge_manifest_names() {
  local -a pkgs
  pkgs=("${(@f)$(sysforge completions manifest 2>/dev/null)}")
  _describe 'package' pkgs
}

_sysforge_local_pkg_names() {
  local -a pkgs
  pkgs=("${(@f)$(sysforge completions local 2>/dev/null)}")
  _describe 'package' pkgs
}

_sysforge_state_names() {
  local -a pkgs
  pkgs=("${(@f)$(sysforge completions state 2>/dev/null)}")
  _describe 'package' pkgs
}

_sysforge_pkg_or_file() {
  _alternative \
    'files:file:_files' \
    'packages:package:_sysforge_pkg_names'
}

_sysforge_makepkg_flags() {
  local -a flags
  flags=("${(@f)$(sysforge completions makepkg-flags 2>/dev/null)}")
  (( $#flags )) && _describe -t makepkg-flags 'makepkg flag' flags
}

_sysforge_build() {
  _arguments \
    '(-m --makepkg)'{-m,--makepkg}'[extra makepkg flags, appended after profile flags]:flags' \
    '--interactive[strip --noconfirm from makepkg_flags]' \
    '--profile-conf[alternate profiles.toml]:file:_files' \
    '--cc[override C compiler for this build]:compiler' \
    '--cxx[override C++ compiler for this build]:compiler' \
    '--ld[override linker for this build]:linker:(lld mold ld bfd)' \
    '--no-pkg-log[disable per-package log file]' \
    '--log-dir[directory for per-package log]:directory:_files -/' \
    '--persist-log[keep log after a successful build]' \
    '--cache-report[print ccache/sccache summary after build]' \
    '--abi-check[run post-build ABI compatibility check on built shared libraries]' \
    '--no-update[skip git pull --rebase before building]' \
    '--cleansrc[purge src dir and re-clone before building (refuses if local work present)]' \
    '--cleansrc-force[purge + re-clone, bypassing the dirty/diverged guard (overwrites local commits)]' \
    '--no-llvm-preflight[suppress the LLVM source pre-flight summary]' \
    '--state-dir[override state directory]:directory:_files -/' \
    '*: :_sysforge_pkg_or_file' \
  && return
  _sysforge_makepkg_flags
}

_sysforge_fetch() {
  _arguments \
    '--no-update[skip git pull --rebase for already-cloned packages]' \
    '--cleansrc[purge src dirs and re-clone (refuses if local work present)]' \
    '--cleansrc-force[purge + re-clone, bypassing the dirty/diverged guard]' \
    '--no-llvm-preflight[suppress the LLVM source pre-flight summary]' \
    '--profile-conf[alternate profiles.toml]:file:_files' \
    '*: :_sysforge_pkg_names'
}

_sysforge_update() {
  _arguments \
    '--packages[path to packages.toml override file]:file:_files' \
    '--dry-run[show what would be rebuilt without doing it]' \
    '--devel[resolve VCS packages (-git, -svn, -hg, -bzr) via pkgver() and rebuild only those past installed; reuses per-package upstream commits via git ls-remote on subsequent runs]' \
    '--offline[no network: skip pulls, clones, and AUR RPC]' \
    '--install-only[skip rebuild; install only pre-built artifacts in PKGDEST newer than installed (implies --offline)]' \
    '--interactive[pause on build failures to allow manual correction]' \
    '--no-cleanbuild[skip automatic --cleanbuild; useful to re-run only the install step]' \
    '--cleansrc[purge src dirs and re-clone before building (only for packages needing rebuild)]' \
    '--cleansrc-force[purge + re-clone, bypassing the dirty/diverged guard (overwrites local commits)]' \
    '--no-llvm-preflight[suppress the LLVM source pre-flight summary]' \
    '--no-toolchain-preflight[skip toolchain pre-flight (rust/cmake/meson + lib32 cross targets)]' \
    '--include-stage-owned[include packages owned by a pipeline stage (e.g. kernel-stage linux-custom)]' \
    '--explain-drift[list packages built under a different toolchain variant than is active now, then exit]' \
    '--rebuild-on-toolchain-drift[promote UP_TO_DATE packages with toolchain drift to NEEDS_REBUILD]' \
    '(-m --makepkg)'{-m,--makepkg}'[extra makepkg flags]:flags' \
    '--state-dir[override state directory]:directory:_files -/' \
    '--profile-conf[alternate profiles.toml]:file:_files' \
    '--cache-report[print ccache/sccache summary after run]' \
    '--no-pkg-log[disable per-package log files]' \
    '--persist-log[keep log files after successful completion]' \
    '--log-dir[directory for per-package log files]:directory:_files -/' \
    '*: :_sysforge_state_names' \
  && return
  _sysforge_makepkg_flags
}

_sysforge_resolve() {
  _arguments \
    '--show-flags[print the full resolved flag set]' \
    '--deps[show transitive dependency tree with build order]' \
    '--profile-conf[alternate profiles.toml]:file:_files' \
    '1: :_sysforge_local_pkg_names'
}


_sysforge_converge() {
  _arguments \
    '--apply[rebuild all packages whose flags have drifted from the current profile]' \
    '--state-dir[override state directory]:directory:_files -/' \
    '--profile-conf[alternate profiles.toml]:file:_files' \
    '--no-pkg-log[disable per-package log files (only relevant with --apply)]' \
    '--persist-log[keep log files after completion (only relevant with --apply)]' \
    '--log-dir[directory for per-package log files]:directory:_files -/' \
    '--cache-report[print ccache/sccache summary after --apply]' \
    '--no-llvm-preflight[suppress the LLVM source pre-flight summary]' \
    '*: :_sysforge_state_names' \
  && return
  _sysforge_makepkg_flags
}

_sysforge_doctor() {
  _arguments \
    '--graphics[expand to curated graphics stack (mesa/vulkan/libglvnd + driver)]' \
    '--hardware[inventory PCI/USB devices + audit running kernel for missing drivers / boot-config gaps]' \
    '--all[verify every installed package, foreign + non-foreign (pacman -Q)]' \
    '--repo[verify every non-foreign (native repo) package]' \
    '--shallow[do not recurse into transitive dependencies]' \
    '(-q --quiet)'{-q,--quiet}'[suppress clean lines; print only issues]' \
    '(-s --suggest)'{-s,--suggest}'[reverse-lookup candidate packages for each missing soname via pacman -Fq]' \
    '--apply[hand REBUILD candidates to sysforge update; implies --suggest]' \
    '--no-confirm[skip the y/N prompt before --apply rebuilds]' \
    '--dry-run[report --apply work without rebuilding]' \
    '*:installed package:_sysforge_installed_pkg_names'
}

_sysforge_installed_pkg_names() {
  local -a pkgs
  pkgs=("${(@f)$(pacman -Qq 2>/dev/null)}")
  _describe 'installed package' pkgs
}

_sysforge_packages() {
  local context state state_descr line
  typeset -A opt_args

  _arguments -C \
    '--packages[path to packages.toml]:file:_files' \
    '--orphans[with list: show only entries whose package is not currently installed]' \
    '1: :_sysforge_packages_subcommands' \
    '*:: :->args'

  case $state in
    args)
      case $words[1] in
        list)   _sysforge_packages_list   ;;
        add)    _sysforge_packages_add    ;;
        remove) _sysforge_packages_remove ;;
      esac
      ;;
  esac
}

_sysforge_packages_subcommands() {
  local subcommands=(
    'list:show override entries in packages.toml'
    'add:add or update an override entry'
    'remove:remove an override entry'
  )
  _describe 'subcommand' subcommands
}

_sysforge_packages_list() {
  _arguments \
    '--packages[path to packages.toml]:file:_files' \
    '--orphans[show only entries whose package is not currently installed]'
}

_sysforge_packages_add() {
  _arguments \
    '--packages[path to packages.toml]:file:_files' \
    '--source[pin routing (metadata; doesn'\''t satisfy validation alone)]:source:(repo aur local)' \
    '--pkgbuild-patch[patch PKGBUILD flags before build]' \
    '--no-cache[disable ccache/sccache for this package (required for PGO)]' \
    '--reason[free-form note attached to the entry]:text' \
    '1: :_sysforge_pkg_names'
}

_sysforge_packages_remove() {
  _arguments \
    '--packages[path to packages.toml]:file:_files' \
    '1: :_sysforge_manifest_names'
}

_sysforge_state() {
  local context state state_descr line
  typeset -A opt_args

  _arguments -C \
    '1: :_sysforge_state_subcommands' \
    '*:: :->args'

  case $state in
    args)
      case $words[1] in
        list)    _sysforge_state_list    ;;
        repair)  _sysforge_state_repair  ;;
        orphans) _sysforge_state_orphans ;;
        failed)  _sysforge_state_failed  ;;
      esac
      ;;
  esac
}

_sysforge_state_subcommands() {
  local subcommands=(
    'list:tabulate build_state.toml entries'
    'repair:re-parse PKGBUILDs to fix entries with unexpanded shell variables'
    'orphans:list (and optionally prune) stale .pkg.tar* artifacts in PKGDEST'
    'failed:list recorded build failures (with any diagnosed fix)'
  )
  _describe 'subcommand' subcommands
}

_sysforge_state_list() {
  _arguments \
    '--state-dir[override state directory]:dir:_directories' \
    '--no-pager[do not pipe output through $PAGER]'
}

_sysforge_state_orphans() {
  _arguments \
    '--prune[delete the listed superseded artifacts]' \
    '--no-confirm[skip the y/N prompt when pruning]' \
    '--no-pager[do not pipe output through $PAGER]'
}

_sysforge_state_repair() {
  _arguments \
    '--state-dir[override state directory]:dir:_directories' \
    '--dry-run[show planned repair without writing]'
}

_sysforge_state_failed() {
  _arguments \
    '--state-dir[override state directory]:dir:_directories' \
    '--no-pager[do not pipe output through $PAGER]' \
    '--clear[clear the recorded failure for PKGBASE]:pkgbase:_sysforge_state_names' \
    '--clear-all[clear all recorded failures]'
}

_sysforge_run() {
  local context state state_descr line
  typeset -A opt_args

  _arguments -C \
    '1: :_sysforge_run_stages' \
    '*:: :->args'

  case $state in
    args)
      case $words[1] in
        pipeline)    _sysforge_run_pipeline    ;;
        hardware)    _sysforge_run_hardware    ;;
        reconfigure) _sysforge_run_reconfigure ;;
        toolchain)   _sysforge_run_toolchain   ;;
        packages)    _sysforge_run_packages    ;;
        kernel)      _sysforge_run_kernel      ;;
      esac
      ;;
  esac
}

_sysforge_run_stages() {
  local stages=(
    'pipeline:run the full install pipeline (stages 1-8)'
    'hardware:re-run hardware detection and refresh hardware_profile.toml'
    'reconfigure:pre-build checkpoint'
    'toolchain:build and install the LLVM/GCC toolchain'
    'packages:build and install packages from packages.toml'
    'kernel:build and install the custom kernel'
  )
  _describe 'stage' stages
}

_sysforge_run_hardware() {
  _arguments \
    '--dry-run[show what would be written without writing]' \
    '--state-dir[override state directory]:directory:_files -/'
}

_sysforge_run_pipeline() {
  _arguments \
    '--resume[continue from the last checkpoint]' \
    '--start-from[begin from this stage]:stage:(reconfigure toolchain packages kernel)' \
    '--force-retry[retry failed packages without prompting]' \
    '--dry-run[show what would run without executing]' \
    '--packages[path to packages.toml]:file:_files' \
    '--state-dir[override state directory]:directory:_files -/' \
    '--profile-conf[alternate profiles.toml]:file:_files' \
    '--no-unified-log[disable unified log file]' \
    '--no-pkg-logs[disable per-package log files]' \
    '--log-dir[directory for log files]:directory:_files -/' \
    '--purge-log[truncate unified log before this run]' \
    '--persist-log[keep logs after successful run]' \
    '--cache-report[print ccache/sccache summary after pipeline]' \
    '--abi-check[run post-build ABI compatibility check on built shared libraries]' \
    '--no-update[skip git pull --rebase before each build]'
}

_sysforge_run_reconfigure() {
  _arguments \
    '--dry-run[run all steps non-interactively without writing changes]' \
    '--packages[path to packages.toml]:file:_files' \
    '--state-dir[override state directory]:directory:_files -/'
}

_sysforge_run_toolchain() {
  _arguments \
    '--dry-run[show what would run without executing]' \
    '--no-update[skip git pull --rebase before each build]' \
    '(-m --makepkg)'{-m,--makepkg}'[extra makepkg flags]:flags' \
    '--persist-log[keep logs after successful run]' \
    '--cache-report[print ccache/sccache summary after run]' \
    '--abi-check[run post-build ABI compatibility check on built shared libraries]' \
    '--state-dir[override state directory]:directory:_files -/' \
    '--rebuild-profdata[force a full 3-pass PGO build even if profdata exists]' \
    '--auto-pgo[bypass PGO confirmation prompts; required for non-interactive PGO]' \
    '--allow-dirty-llvm[bypass the LLVM safety pre-flight refusal on dirty/diverged trees]' \
    '--cleansrc[purge each toolchain src dir and re-clone (refuses if local work present)]' \
    '--cleansrc-force[purge + re-clone, bypassing the dirty/diverged guard (overwrites local commits)]' \
  && return
  _sysforge_makepkg_flags
}

_sysforge_run_packages() {
  _arguments \
    '--packages[path to packages.toml]:file:_files' \
    '--dry-run[show what would run without executing]' \
    '--force-retry[retry failed packages without prompting]' \
    '--no-update[skip git pull --rebase before each build]' \
    '--no-pkg-logs[disable per-package log files]' \
    '--persist-log[keep logs after successful run]' \
    '--log-dir[directory for log files]:directory:_files -/' \
    '--cache-report[print ccache/sccache summary after run]' \
    '--abi-check[run post-build ABI compatibility check on built shared libraries]' \
    '--state-dir[override state directory]:directory:_files -/' \
    '--profile-conf[alternate profiles.toml]:file:_files'
}

_sysforge_run_kernel() {
  _arguments \
    '--dry-run[show what would run without executing]' \
    '--no-update[skip git pull --rebase before each build]' \
    '--cleansrc[purge the kernel src dir and re-clone (refuses on dirty trees)]' \
    '--cleansrc-force[like --cleansrc but bypasses the dirty/diverged guard]' \
    '--non-interactive[disable interactive kconfig and patch interactive targets to olddefconfig]' \
    '--compiler[kernel-stage compiler override]:compiler:(gcc llvm)' \
    '--bootloader[override kernel.toml bootloader]:bootloader:(systemd-boot grub none)' \
    '--allow-no-fallback[override the fallback-kernel guarantee (Gate 1)]' \
    '--skip-boot-audit[override the pre-install boot-critical kconfig audit (Gate 2) — dangerous]' \
    '--no-pkg-logs[disable per-package log files]' \
    '--persist-log[keep logs after successful run]' \
    '--log-dir[directory for log files]:directory:_files -/' \
    '--cache-report[print ccache/sccache summary after run]' \
    '--abi-check[run post-build ABI compatibility check on built shared libraries]' \
    '--state-dir[override state directory]:directory:_files -/' \
    '--profile-conf[alternate profiles.toml]:file:_files'
}

_sysforge_setup() {
  _arguments \
    '--pacman-conf[path to pacman.conf]:file:_files'
}

_sysforge_env() {
  _arguments
}

_sysforge_log() {
  _arguments \
    '--state-dir[override state directory]:directory:_files -/' \
    '--no-pager[do not pipe output through $PAGER]' \
    '1: :_sysforge_local_pkg_names'
}

# Internal scaffolding subcommand used by this completion script itself
# (see _sysforge_pkg_names, _sysforge_makepkg_flags, etc.). Hidden from
# `sysforge --help` (argparse.SUPPRESS) but exposed here so that
# `sysforge completions <TAB>` completes the resource argument.
_sysforge_completions() {
  _arguments \
    '1:resource:(packages manifest local state makepkg-flags)'
}
