_sysforge_help() {
  # `sysforge help [COMMAND [SUBCOMMAND]]` — first word is any verb, second is
  # that verb's subcommand when it has one (2.5.0-F2).
  case $CURRENT in
    2) _sysforge_commands ;;
    3)
      case $words[2] in
        artifact) _sysforge_artifact_subcommands ;;
        config)   _sysforge_config_subcommands   ;;
        doctor)   _sysforge_doctor_subcommands   ;;
        packages) _sysforge_packages_subcommands ;;
        run)      _sysforge_run_stages           ;;
        state)    _sysforge_state_subcommands    ;;
      esac
      ;;
  esac
}

_sysforge_log() {
  _arguments \
    '--state-dir[override state directory]:directory:_files -/' \
    '--no-pager[do not pipe output through $PAGER]' \
    '1: :_sysforge_local_pkg_names'
}

_sysforge_config() {
  local context state state_descr line
  typeset -A opt_args

  _arguments -C \
    '1: :_sysforge_config_subcommands' \
    '*:: :->args'

  case $state in
    args)
      case $words[1] in
        merge) _sysforge_config_merge ;;
      esac
      ;;
  esac
}

_sysforge_config_subcommands() {
  local subcommands=(
    'merge:interactively adopt or clear .sfnew/.pacnew config companions'
  )
  _describe 'subcommand' subcommands
}

_sysforge_config_merge() {
  _arguments \
    '--config-dir[live config dir to scan]:directory:_files -/' \
    '--list[list companion files without prompting (non-interactive)]' \
    '--dry-run[same as --list: report companions without merging]' \
    '--no-pager[do not pipe diffs through $PAGER]'
}

# Internal scaffolding subcommand used by this completion script itself
# (see _sysforge_pkg_names, _sysforge_makepkg_flags, etc.). Hidden from
# `sysforge --help` (argparse.SUPPRESS) but exposed here so that
# `sysforge completions <TAB>` completes the resource argument.
_sysforge_completions() {
  _arguments \
    '1:resource:(packages manifest local state makepkg-flags)'
}
