# Container for the terminal recordings (docs/assets/*.tape) and the
# end-to-end tier (tools/e2e/).
#
# A fresh Arch system with an unprivileged `demo` user (provision.sh). sysforge
# itself is built from the checkout by install.sh, not here, so the image
# doesn't go stale with every commit.
FROM docker.io/library/archlinux:base-devel

COPY provision.sh /usr/local/sbin/sysforge-provision
RUN /usr/local/sbin/sysforge-provision

CMD ["sleep", "infinity"]
